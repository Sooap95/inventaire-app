    "test:phase8a0-security": "node security/scripts/run-security.mjs --a0",
    "plan:preprod:local": "node scripts/plan_preprod.mjs --stage A2-L",
    "build:preprod:local": "python3 scripts/build_preprod_local.py",
    "check:preprod:local": "python3 scripts/check_preprod_local.py",
    "serve:preprod:local": "python3 scripts/serve_preprod_local.py",
    "test:preprod:browser": "python3 tests/preprod-a2-browser.py",
    "test:preprod:security": "node security/scripts/run-security.mjs --a2",
    "test:preprod:emulator-browser": "node security/scripts/run-security.mjs --a2-browser"
