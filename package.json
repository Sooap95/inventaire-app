    "serve:labs": "python3 scripts/serve_labs.py",
    "test:browser": "python3 tests/browser.py",
    "prepare:ocr": "python3 scripts/prepare_ocr.py",
    "test:ocr-browser": "python3 tests/ocr_browser.py",
    "test:ocr-fallback": "python3 tests/ocr_fallback_browser.py",
    "build:ocr-site": "python3 scripts/build_ocr_site.py",
    "serve:ocr-site": "python3 scripts/serve_ocr_site.py",
    "test:ocr-site": "python3 tests/ocr_static_browser.py",
    "serve:shopping-lab": "python3 scripts/serve_shopping_lab.py",
    "test:shopping-browser": "python3 tests/shopping-browser.py",
    "test:shopping-c-browser": "python3 tests/shopping-c-browser.py",
    "test:cases": "node --test --test-isolation=none tests/*.test.mjs",
    "test:security": "npm --prefix security test",
    "test:phase3-pre-browser": "python3 tests/phase3-pre-browser.py",
    "build:family-lab": "python3 scripts/build_family_lab.py",
    "serve:family-lab": "python3 scripts/serve_family_lab.py",
    "test:family-security": "node security/scripts/run-security.mjs --family",
    "test:family-browser": "node security/scripts/run-security.mjs --family-browser",
    "lab:family": "node security/scripts/run-security.mjs --lab",
    "test:device-security": "node security/scripts/run-security.mjs --devices",
    "test:device-browser": "node security/scripts/run-security.mjs --device-browser",
    "test:recovery": "node security/scripts/run-security.mjs --recovery",
    "test:identifiers-browser": "python3 tests/identifiers-browser.py",
    "test:phase5-security": "node security/scripts/run-security.mjs --all-security",
    "test:device-lab-smoke": "python3 tests/device-lab-smoke.py",
    "build:mobile-ui": "python3 scripts/build_mobile_ui.py",
    "serve:mobile-ui": "python3 scripts/serve_mobile_ui.py",
    "test:mobile-ui": "python3 tests/mobile-ui-browser.py",
    "test:phase6-integration": "node security/scripts/run-security.mjs --integration-browser",
    "check:mobile-ui": "python3 scripts/check_mobile_ui.py",
